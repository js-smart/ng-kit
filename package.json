{
	"name": "ng-kit",
	"version": "22.10.2",
	"scripts": {
		"ng": "ng",
		"start": "ng serve ng-kit-demo --port=4300",
		"build": "ng build ng-kit --configuration=production",
		"build:demo": "ng build ng-kit-demo --configuration=production",
		"watch": "ng build --watch --configuration development",
		"test": "CI=true ng test ng-kit",
		"test:store": "CI=true ng test ng-kit --include='**/store/*.spec.ts'",
		"format": "prettier --cache --write .",
		"format:write": "prettier --cache --write .",
		"format:check": "prettier --check .",
		"bundle:report": "ng build --configuration production --source-map=true && source-map-explorer dist/pres/**/*.js",
		"e2e": "CI=true URL=http://localhost:4300 npx playwright test ng-kit-demo",
		"lint": "ng lint ng-kit",
		"prepare": "husky"
	},
	"release": {
		"branches": [
			"main"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			[
				"@semantic-release/npm",
				{
					"pkgRoot": "dist/ng-kit"
				}
			],
			"@semantic-release/git",
			"@semantic-release/github"
		]
	},
	"private": false,
	"dependencies": {
		"@angular/animations": "^22.2.0",
		"@angular/cdk": "22.2.0",
		"@angular/common": "^22.2.0",
		"@angular/compiler": "^22.2.0",
		"@angular/core": "^22.2.0",
		"@angular/forms": "^22.2.0",
		"@angular/material": "22.2.0",
		"@angular/platform-browser": "^22.2.0",
		"@angular/router": "^22.2.0",
		"@tanstack/query-core": "^5.104.0",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@angular/build": "^22.2.0",
		"@angular/cli": "^22.2.0",
		"@angular/compiler-cli": "^22.2.0",
		"@eslint/js": "^10.0.1",
		"@netlify/angular-runtime": "^4.0.0",
		"@playwright/test": "^1.63.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/npm": "^13.2.0",
		"@stackblitz/sdk": "^1.11.1",
		"@types/node": "^26.6.3",
		"@vitest/browser-playwright": "^5.0.2",
		"angular-eslint": "22.5.0",
		"baseline-browser-mapping": "^2.11.26",
		"eslint": "^10.11.0",
		"highlight.js": "^11.12.0",
		"husky": "^9.1.7",
		"istanbul-lib-instrument": "^6.0.3",
		"lint-staged": "^17.6.0",
		"ng-packagr": "^22.2.2",
		"prettier": "^3.9.9",
		"semantic-release": "^25.0.9",
		"typescript": "~6.0.3",
		"typescript-eslint": "8.71.0",
		"vitest": "^5.0.2",
		"zone.js": "~0.16.3"
	},
	"browserslist": [
		"last 2 Chrome versions",
		"last 2 ChromeAndroid versions",
		"last 2 Firefox versions",
		"last 2 Edge versions",
		"last 2 Safari major versions",
		"last 2 iOS major versions"
	],
	"lint-staged": {
		"*": "prettier --cache --write --ignore-unknown"
	}
}
